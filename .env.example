# Copy to .env.local for development. Never commit real values.
# With the Supabase values left empty, QuickQReate runs as the free generator without accounts.

# Public URL of the app; dynamic QR codes encode <NEXT_PUBLIC_SITE_URL>/r/<slug>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The QuickQReate project's HTTPS API URL and anon key (both browser-safe).
# Use the project API address, never the Studio or Coolify management address.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose these to the browser or commit them.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters; salts the daily visitor hash used for unique-scan counts.
SCAN_HASH_SECRET=
