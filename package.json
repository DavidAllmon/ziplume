{
  "name": "ziplume",
  "version": "2.0.0",
  "private": true,
  "description": "Create beautiful, scannable QR codes for links, Wi-Fi, contacts and more. Runs entirely in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/generate-sw.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "npx --yes supabase@2.120.0 start -x realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "npx --yes supabase@2.120.0 stop",
    "test:e2e:accounts": "node scripts/accounts-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "node scripts/build-brand-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "svg2pdf.js": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
